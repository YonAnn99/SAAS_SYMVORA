  hidden: { opacity: 0, x: -40 },
  visible: { opacity: 1, x: 0 },
};

export const fadeInRight: Variants = {
  hidden: { opacity: 0, x: 40 },
  visible: { opacity: 1, x: 0 },
};

export const scaleIn: Variants = {
  hidden: { opacity: 0, scale: 0.95 },
  visible: { opacity: 1, scale: 1 },
};

// Spring configurations
export const springTransition: Transition = {
  type: "spring",
  stiffness: 300,
  damping: 30,
};

export const springSoft: Transition = {
  type: "spring",
  stiffness: 200,
  damping: 20,
};

export const springIcon: Transition = {
  type: "spring",
  stiffness: 300,
  damping: 20,
};

// Custom cubic-bezier for premium feel
export const cubicBezierPremium: Transition = {
  ease: [0.32, 0.72, 0, 1],
};

export const cubicBezierSnappy: Transition = {
  ease: [0.16, 1, 0.3, 1],
};

/**
 * GSAP ScrollTrigger helpers - lazy loaded
 * These are type-only exports for type safety; actual GSAP is lazy-loaded at runtime
 */
export interface GSAPStickyStackConfig {
  cards: React.ReactNode[];
  containerRef: React.RefObject<HTMLDivElement>;
  reduceMotion: boolean;
}

export interface GSAPHorizontalPanConfig {
  children: React.ReactNode;
  wrapRef: React.RefObject<HTMLDivElement>;
  trackRef: React.RefObject<HTMLDivElement>;
  reduceMotion: boolean;
}

/**
 * Motion scroll reveal stagger - canonical skeleton (lighter alternative to GSAP)
 */
export const scrollRevealStagger = {
  hidden: { opacity: 0, y: 24 },
  visible: {
    opacity: 1,
    y: 0,
    transition: {
      duration: 0.6,
      ease: [0.16, 1, 0.3, 1] as const,
    },
  },
};

/**
 * Scroll reveal stagger with custom delay
 */
export const createScrollRevealStagger = (delay: number = 0.06): Variants => ({
  hidden: { opacity: 0, y: 24 },
  visible: {
    opacity: 1,
    y: 0,
    transition: {
      duration: 0.6,
      delay,
      ease: [0.16, 1, 0.3, 1] as const,
    },
  },
};

/**
 * Magnetic button hover physics variants
 */
export const magneticButton: Variants = {
  initial: { scale: 1 },
  hover: {
    scale: 1.02,
    transition: { type: "spring", stiffness: 300, damping: 30 },
  },
  tap: {
    scale: 0.98,
    transition: { duration: 0.1 },
  },
};

/**
 * Magnetic icon wrapper physics
 */
export const magneticIcon: Variants = {
  initial: { x: 0, y: 0, scale: 1 },
  hover: {
    x: 4,
    y: -4,
    scale: 1.05,
    transition: { type: "spring", stiffness: 300, damping: 30 },
  },
};

/**
 * Scroll reveal with blur-to-sharp transition
 */
export const blurToSharp: Variants = {
  hidden: { opacity: 0, y: 16, filter: "blur(8px)" },
  visible: {
    opacity: 1,
    y: 0,
    filter: "blur(0px)",
    transition: {
      duration: 0.7,
      ease: [0.16, 1, 0.3, 1] as const,
    },
  },
};

/**
 * Scale + fade with spring
 */
export const scaleFadeSpring: Variants = {
  hidden: { opacity: 0, scale: 0.95 },
  visible: {
    opacity: 1,
    scale: 1,
    transition: {
      type: "spring",
      stiffness: 300,
      damping: 30,
    },
  },
};

/**
 * Page transition variants
 */
export const pageTransition: Variants = {
  initial: { opacity: 0, y: 20 },
  enter: {
    opacity: 1,
    y: 0,
    transition: {
      duration: 0.5,
      ease: [0.16, 1, 0.3, 1] as const,
    },
  },
  exit: {
    opacity: 0,
    y: -20,
    transition: {
      duration: 0.3,
      ease: [0.16, 1, 0.3, 1] as const,
    },
  },
};

export const pageTransitionSlow: Variants = {
  initial: { opacity: 0, y: 30 },
