# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Conekta (Payment Gateway)
CONEKTA_PRIVATE_KEY=key_xxxxxxxxxxxxxxxx
CONEKTA_PUBLIC_KEY=key_xxxxxxxxxxxxxxxx
CONEKTA_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Stitch MCP (Google Cloud API key)
# Used by opencode.json MCP stitch server. Keep out of version control.
STITCH_API_KEY=your-gcp-api-key
