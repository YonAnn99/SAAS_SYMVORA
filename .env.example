# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Conekta (Payment Gateway)
CONEKTA_PRIVATE_KEY=key_xxxxxxxxxxxxxxxx
CONEKTA_PUBLIC_KEY=key_xxxxxxxxxxxxxxxx
# RSA public key from https://api.conekta.io/webhook_keys (used to verify
# the DIGEST header on incoming webhooks). Signs with SHA-256 + RSA.
CONEKTA_WEBHOOK_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Stitch MCP (Google Cloud API key)
# Used by opencode.json MCP stitch server. Keep out of version control.
STITCH_API_KEY=your-gcp-api-key
